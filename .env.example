# ---------------------------------------------------------------------------
# Navio — server-side environment. NEVER expose these to the browser.
# Copy to .env.local for development, and set them in your host's
# Environment Variables panel for production. Values stay empty here.
# ---------------------------------------------------------------------------

# A single direct credential is enough to run everything: set this and leave
# the two pool keys empty. Pool keys win when both are present.
GROQ_API_KEY=

# Wind primary engine: fast conversational layer, routing + synthesis.
WIND_PRIMARY_API_KEY=
# Wind specialist pool: deep specialists (code, finance, vision, reasoning, data).
WIND_SPECIALIST_API_KEY=

# --- Optional overrides -----------------------------------------------------
# Endpoints are OpenAI-compatible chat-completions bases. Leave blank to use
# the built-in server-side defaults in src/lib/wind/adapters/endpoints.ts
WIND_PRIMARY_BASE_URL=
WIND_SPECIALIST_BASE_URL=

# Model identifiers. Leave blank to use the defaults in src/lib/wind/models.ts
WIND_MODEL_PRIMARY=
WIND_MODEL_CODE=
WIND_MODEL_FINANCE=
WIND_MODEL_REASONING=
WIND_MODEL_VISION=
WIND_MODEL_DATA=

# Runtime guardrails (all optional, sensible defaults applied).
WIND_MAX_SPECIALIST_CALLS=
WIND_MAX_ORCHESTRATION_DEPTH=
WIND_REQUEST_TIMEOUT_MS=
WIND_TASK_TIMEOUT_MS=
WIND_RATE_LIMIT_PER_MINUTE=

# Public identity of the deployment (safe to expose).
NEXT_PUBLIC_NAVIO_URL=http://localhost:3000

# Access to the workspace. Leave both empty to keep /app sealed behind the
# public site. The pre-rename names (COWIND_*) are still read as a fallback.
NAVIO_WORKSPACE_ENABLED=
NAVIO_PREVIEW_KEY=
